{
	"name": "pi-steering",
	"version": "0.1.0",
	"private": true,
	"description": "Steer long Pi agent runs back on track every ten tool calls.",
	"type": "module",
	"keywords": [
		"pi-package"
	],
	"license": "MIT",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"check": "npm run typecheck && npm run lint && npm test",
		"lint": "biome check .",
		"test": "node --experimental-strip-types --test",
		"typecheck": "tsc --noEmit"
	},
	"files": [
		"src",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.85.1 <1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@types/node": "^22.10.0",
		"typescript": "^5.9.0"
	}
}
